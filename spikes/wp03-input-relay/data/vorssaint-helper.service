[Unit]
Description=Vorssaint input relay helper
Documentation=file:///usr/share/doc/vorssaint/PRIVILEGES.md
# The helper is useless without a bus to be reached on, and must not linger
# after it.
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=org.vorssaint.Helper1
ExecStart=/usr/libexec/vorssaint-helper
Restart=on-failure
RestartSec=2

# The helper needs exactly two things: /dev/input/event* to read and
# /dev/uinput to write. Everything below removes something it does not need,
# so a bug in the JSON parser buys an attacker as little as possible. It is
# deliberately not DynamicUser: it must open root-owned device nodes and it
# keeps no state of its own.
User=root
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
DeviceAllow=char-input rw
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @obsolete
UMask=0077

[Install]
WantedBy=multi-user.target
